{
  "name": "Blind Guide",
  "short_name": "Blind Guide",
  "description": "Waterfowl hunting journal — log hunts, track spots, and read the forecast.",
  "id": "/",
  "start_url": "/hunts",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#F1F2F4",
  "theme_color": "#FFFFFF",
  "categories": ["sports", "utilities", "lifestyle"],
  "icons": [
    {
      "src": "/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log a hunt",
      "short_name": "Log hunt",
      "url": "/hunts/create",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Forecast",
      "short_name": "Forecast",
      "url": "/forecast",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
